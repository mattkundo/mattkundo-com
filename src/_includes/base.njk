<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="stylesheet" href="/assets/css/main.css">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<meta property="og:type" content="{{ ogType or 'profile' }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/matt-kundo-portrait.jpg">
<meta name="twitter:card" content="summary">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.name }}",
  "jobTitle": "Marketing Operations and GTM Engineering",
  "url": "{{ site.url }}",
  "image": "{{ site.url }}/assets/img/matt-kundo-portrait.jpg",
  "email": "mailto:{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Austin",
    "addressRegion": "TX",
    "addressCountry": "US"
  },
  "worksFor": {
    "@type": "Organization",
    "@id": "https://mattkundodigitalmarketing.com/#organization",
    "name": "MKDM",
    "url": "https://mattkundodigitalmarketing.com"
  },
  "knowsAbout": [
    "Marketing operations",
    "Go-to-market engineering",
    "Marketing attribution",
    "Google Ads",
    "Google Analytics 4",
    "Google Tag Manager",
    "Autonomous AI agents"
  ],
  "sameAs": [
    "{{ site.linkedin }}",
    "{{ site.github }}"
  ]
}
</script>
</head>
<body>
{{ content | safe }}
</body>
</html>
